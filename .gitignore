# Ignore everything by default
*

# Except this
!/.gitignore
!/.gitattributes
!/.markdownlint-cli2.yaml
!/.oxfmtrc.json
!/.oxlintrc.json
!/AGENTS.md
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/bun.lock
!/bunfig.toml
!/lefthook.yml
!/mise.toml
!/package.json
!/pi-otlp.code-workspace
!/tsconfig.json

!/.github/
!/.github/**

!/.pi/
!/.pi/extensions/
!/.pi/extensions/format.ts

!/grafana/
!/grafana/**

!/scripts/
!/scripts/**
!/src/
!/src/**
!/test/
!/test/**

# Generated files inside allowed dirs
**/node_modules/
**/.DS_Store
**/*.log
**/.env
**/.env.*
