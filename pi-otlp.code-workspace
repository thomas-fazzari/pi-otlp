{
  "folders": [{ "path": "." }],
  "settings": {
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "oxc.useExecPath": true,
    "oxc.path.oxfmt": "node_modules/oxfmt/bin/oxfmt",
    "oxc.path.oxlint": "node_modules/oxlint/bin/oxlint",
    "files.associations": {
      "bun.lock": "plaintext",
      "LICENSE": "plaintext",
    },
    "files.exclude": {
      "**/node_modules": true,
    },
    "files.watcherExclude": {
      "**/.git/**": true,
      "**/node_modules/**": true,
    },
    "search.exclude": {
      "**/.git/**": true,
      "**/node_modules/**": true,
    },
    "[javascript][typescript][json][jsonc][yaml][markdown]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[markdown]": {
      "editor.wordWrap": "on",
    },
  },
  "extensions": {
    "recommendations": [
      "hverlin.mise-vscode",
      "oven.bun-vscode",
      "oxc.oxc-vscode",
      "DavidAnson.vscode-markdownlint",
      "redhat.vscode-yaml",
      "tamasfe.even-better-toml",
      "yoavbls.pretty-ts-errors",
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "check",
        "type": "process",
        "command": "mise",
        "args": ["run", "check"],
        "options": {
          "cwd": "${workspaceFolder}",
        },
        "group": {
          "kind": "build",
          "isDefault": true,
        },
        "problemMatcher": [],
      },
      {
        "label": "test",
        "type": "process",
        "command": "mise",
        "args": ["run", "test"],
        "options": {
          "cwd": "${workspaceFolder}",
        },
        "group": "test",
        "problemMatcher": [],
      },
      {
        "label": "fmt",
        "type": "process",
        "command": "mise",
        "args": ["run", "fmt"],
        "options": {
          "cwd": "${workspaceFolder}",
        },
        "problemMatcher": [],
      },
    ],
  },
}
