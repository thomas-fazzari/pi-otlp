    "INFO Session started[gen_ai_agent_name=Explore,gen_ai_conversation_id=#2,gen_ai_provider_name=faux-test,gen_ai_request_model=faux-1,pi_session_kind=subagent,pi_session_start_reason=startup,pi_thinking_level_selected=off]",
    "INFO Session shut down[gen_ai_agent_name=Explore,gen_ai_conversation_id=#2,pi_session_kind=subagent,pi_session_shutdown_reason=quit]",
