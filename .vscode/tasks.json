{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "check",
      "type": "process",
      "command": "mise",
      "args": ["run", "check"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "process",
      "command": "mise",
      "args": ["run", "test"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "fmt",
      "type": "process",
      "command": "mise",
      "args": ["run", "fmt"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
